# Africa Kaiser — example configuration.
# Copy this file to .env and fill in your own values.
# Never commit .env: it is ignored by .gitignore.

# --- Email / SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=website@example.com
SMTP_PASSWORD=
# ssl (port 465), tls (port 587) or none (local testing only)
SMTP_SECURE=ssl
# Comma-separated recipients for website enquiries.
ADMIN_EMAIL=owner@example.com

# --- Admin panel ---
# At least 12 characters, or set ADMIN_PASSWORD_HASH instead.
ADMIN_PASSWORD=
# Optional password_hash() output; takes priority over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
# Optional comma-separated IP allow-list for admin.php.
ADMIN_ALLOWED_IPS=

# --- Optional application settings ---
# Set only when the frontend is hosted on a different origin.
ALLOWED_ORIGIN=
# Defaults to data/africakaiser.sqlite. A path outside the web root is safer.
DB_PATH=
# Salt used for hashing reviewer IP addresses. Set a long random value.
REVIEWS_SALT=replace-with-a-long-random-string
# Publish verified-buyer reviews immediately.
AUTO_APPROVE_VERIFIED=true
